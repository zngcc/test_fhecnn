#!/bin/bash

conda activate mpcnn

if [ "$CONDA_DEFAULT_ENV" != "mpcnn" ]; then
    echo "mpcnn: conda activate mpcnn"
    exit 1
fi
echo "use env: $CONDA_PREFIX"

########
export LIBRARY_PATH=$CONDA_PREFIX/lib:$LIBRARY_PATH
cd cnn_ckks
# make clean
# rm -rf build
cmake -S . -B build \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_PREFIX_PATH=$CONDA_PREFIX \
    -DGMP_INCLUDE_DIR=$CONDA_PREFIX/include \
    -DGMP_LIBRARY=$CONDA_PREFIX/lib/libgmp.so \
    -DNTL_INCLUDE_DIR=$CONDA_PREFIX/include \
    -DNTL_LIBRARY=$CONDA_PREFIX/lib/libntl.so \
    -DCMAKE_CXX_COMPILER=g++ \
    -DCOMP=OFF \
    -DBOOT=OFF \
    -DCNN=ON

cd build
make -j 4
# ./compare
# ./bootstrapping
./cnn 20 10 6 9